+/*
+ * ---------------------------------------------------------------------
+ * 2026-10-06 AHB-stall tracer ("breadcrumbs").
+ *
+ * The RPi 3B+ hang is a bus stall: the CPU blocks forever on one
+ * peripheral access and nothing (not even a FIQ) runs afterwards.
+ * To find WHICH access, emit one character to the console UART
+ * (polled, no termios, no locks) immediately BEFORE (lower case) and
+ * immediately AFTER (upper case) every "rare" DWC OTG register access.
+ * The last character on the serial line at hang time therefore names
+ * the access that never completed:
+ *
+ *   c<n>/C  HCCHAR(n) write (channel enable / reprogram)
+ *   d<n>/D  HCCHAR(n) write with CHDIS set (channel halt request)
+ *   r<n>/R  HCCHAR(n) read
+ *   t<n>/T  HCTSIZ(n) write        s<n>/S  HCSPLT(n) write
+ *   m<n>/M  HCINTMSK(n) write
+ *   i<n>/I  HCINT(n) read          j<n>/J  HCINT(n) write (W1C)
+ *   p/P     GRXSTSP pop (RX status FIFO read)
+ *   w/W     data FIFO write (bus_space_write_region_4 on DFIFO)
+ *   e/E     data FIFO read  (bus_space_read_region_4 on DFIFO)
+ *   h/H     HPRT write              q/Q     HPRT read
+ *   k/K     GINTMSK write
+ *   x/X     other global/host config register write (init, HFIR, PCGCCTL..)
+ *   y/Y     other global/host config register read
+ *   !       halt requested while the TX request queue reported 0 free
+ *           entries (the Linux dwc2 slave-mode "halt_on_queue" case)
+ *
+ * Frequent per-interrupt accesses (GINTSTS, HFNUM, HAINT, GNPTXSTS,
+ * HPTXSTS) are NOT traced to keep the UART volume at a few hundred
+ * bytes/s. If the trail ends in an UPPER-case letter, the stall is in
+ * one of those (or outside the USB driver).
+ *
+ * Runtime switch: dwc_otg_trace_enable (set to 0 from a debugger /
+ * shell to silence). Compile-time removal: -DDWC_OTG_NO_TRACE.
+ * ---------------------------------------------------------------------
+ */
+volatile int dwc_otg_trace_enable = 0;	/* 2026-10-13: off by default, RAM ring replaces it */
+/* weak default so libbsd test programs link; the EPICS app stub overrides it */
+__attribute__((weak)) volatile uint32_t g_fiq_spsr_fix_count;
+static volatile uint32_t dwc_otg_diag_halt_qfull;  /* '!' events */
+/*
+ * 2026-10-13 FIX candidate state:
+ *  - dwc_otg_halt_req_fn[x]: frame number when CHDIS was issued on ch x
+ *  - overlap_block: allocations deferred because the same endpoint still
+ *    had an IN channel waiting for its halt to complete
+ *  - overlap_timeout: deferrals given up after DWC_OTG_HALT_WAIT_MAX frames
+ */
+#define	DWC_OTG_HALT_WAIT_MAX	64	/* (micro)frames: 8 ms at HS */
+#define	DWC_OTG_NAK_HOLDOFF_HS	8	/* microframes, like Linux nak_holdoff */
+volatile int dwc_otg_fix_enable = 0;	/* 1 = no-overlap + NAK holdoff (did not help 2026-10-13) */
+static uint16_t dwc_otg_halt_req_fn[16];
+static volatile uint32_t dwc_otg_diag_overlap_block;
+static volatile uint32_t dwc_otg_diag_overlap_timeout;
+static volatile uint32_t dwc_otg_diag_nak_holdoff;
+
+static __inline void
+dwc_otg_trace_putc(char c)
+{
+#ifndef DWC_OTG_NO_TRACE
+	if (dwc_otg_trace_enable != 0)
+		(*BSP_output_char)(c);
+#else
+	(void)c;
+#endif
+}
+
+/* classify a register offset; returns 0 for "do not trace" */
+static __inline char
+dwc_otg_trace_class(uint32_t reg, int is_write, uint32_t data, int *chan)
+{
+	*chan = -1;
+	if (reg >= 0x1000)			/* DFIFO windows: handled by region ops */
+		return (0);
+	if (reg >= 0x500 && reg < 0x700) {	/* host channel registers */
+		*chan = (int)((reg - 0x500) >> 5);
+		switch (reg & 0x1c) {
+		case 0x00:	/* HCCHAR */
+			if (!is_write)
+				return ('r');
+			return ((data & HCCHAR_CHDIS) ? 'd' : 'c');
+		case 0x04:	return (is_write ? 's' : 0);	/* HCSPLT */
+		case 0x08:	return (is_write ? 'j' : 'i');	/* HCINT */
+		case 0x0c:	return (is_write ? 'm' : 0);	/* HCINTMSK */
+		case 0x10:	return (is_write ? 't' : 0);	/* HCTSIZ */
+		default:	return (0);
+		}
+	}
+	switch (reg) {
+	case DOTG_GINTSTS:
+	case DOTG_HFNUM:
+	case DOTG_HAINT:
+	case DOTG_HAINTMSK:
+	case DOTG_GNPTXSTS:
+	case DOTG_HPTXSTS:
+	case DOTG_GRXSTSRH:
+		return (0);			/* too frequent / harmless */
+	case DOTG_GRXSTSPH:
+		return (is_write ? 0 : 'p');
+	case DOTG_HPRT:
+		return (is_write ? 'h' : 'q');
+	case DOTG_GINTMSK:
+		return (is_write ? 'k' : 0);
+	default:
+		if (reg >= 0x800 && reg < 0xe00)	/* device-mode registers */
+			return (0);
+		return (is_write ? 'x' : 'y');
+	}
+}
+
+/*
+ * ---------------------------------------------------------------------
+ * 2026-10-13 RAM crash ring ("black box").
+ *
+ * Every DWC OTG register access is recorded in an uncached RAM ring at a
+ * fixed physical address outside the RTEMS memory map (RTEMS uses
+ * 0x00200000..0x10000000). Each entry is written BEFORE the access with
+ * DONE=0, flushed with DSB, then marked DONE after the access returns.
+ * After the bus freeze the BCM2835 PM watchdog (petted by heartbeat.c)
+ * resets the SoC; DRAM keeps its content across that reset, and on the
+ * next boot dwc_otg_init() prints the tail of the old ring before
+ * reusing it. The newest entry with DONE=0 is the access that hung.
+ * ---------------------------------------------------------------------
+ */
+#include <libcpu/arm-cp15.h>
+
+#define	DWC_RING_PHYS		0x28000000u	/* 640 MB, 1 MB section */
+#define	DWC_RING_ENTRIES	16384u		/* 16 B each = 256 KB */
+#define	DWC_RING_DUMP		600u		/* entries printed after reset */
+#define	DWC_RING_MAGIC0		0x44574352u	/* "DWCR" */
+#define	DWC_RING_MAGIC1		0x2026a13bu
+
+#define	DWC_RT_READ		0x1u
+#define	DWC_RT_WRITE		0x2u
+#define	DWC_RT_FIFO_WR		0x3u
+#define	DWC_RT_FIFO_RD		0x4u
+#define	DWC_RT_MARK		0x5u
+#define	DWC_RT_DONE		0x08000000u
+
+struct dwc_ring_entry {
+	uint32_t seq;
+	uint32_t tag;		/* [31:28] type, [27] done, [15:0] reg */
+	uint32_t val;		/* value written / read, or FIFO word count */
+	uint32_t tim;		/* CNTVCT low 32 bits (19.2 MHz) */
+};
+
+struct dwc_ring {
+	uint32_t magic0;
+	uint32_t magic1;
+	uint32_t boot_count;
+	uint32_t check;		/* magic0 ^ magic1 ^ boot_count */
+	uint32_t cnt_freq;
+	uint32_t pad[3];
+	struct dwc_ring_entry e[DWC_RING_ENTRIES];
+};
+
+static struct dwc_ring *dwc_ring;	/* NULL until mapped */
+static uint32_t dwc_ring_seq;
+static struct dwc_otg_softc *dwc_ring_sc;	/* set in dwc_otg_init() */
+/*
+ * 2026-10-13 write probe. The BCM2837 ARM->peripheral bridge acknowledges
+ * writes early (posted), so a write that wedges the DWC OTG AHB slave is
+ * reported "done" to the CPU and only the NEXT peripheral access hangs
+ * (in the 2026-10-13 capture that next access was outside this driver).
+ * With the probe, every register write is followed by a read of GSNPSID
+ * (0x040, side-effect free): a read cannot be acknowledged early, so a
+ * stuck write now shows as "R reg=0x040 *** PENDING" right after it.
+ * It also serializes posted writes, which may by itself be a cure.
+ */
+volatile int dwc_otg_wprobe_enable = 0;	/* 2026-10-13 soak build: off (production timing) */
+/* period of the "DWC_OTG t=" console dump in seconds, 0 = off (iocsh var) */
+volatile int dwc_otg_diag_period = 60;
+#define	DOTG_GSNPSID_OFF	0x040u
+
+static __inline uint32_t
+dwc_ring_now(void)
+{
+	return ((uint32_t)arm_cp15_get_counter_virtual_count());
+}
+
+static __inline struct dwc_ring_entry *
+dwc_ring_begin(uint32_t type, uint32_t reg, uint32_t val)
+{
+	struct dwc_ring_entry *e;
+	uint32_t seq;
+
+	if (dwc_ring == NULL)
+		return (NULL);
+	seq = ++dwc_ring_seq;
+	e = &dwc_ring->e[seq & (DWC_RING_ENTRIES - 1)];
+	e->tag = (type << 28) | (reg & 0xffff);
+	e->val = val;
+	e->tim = dwc_ring_now();
+	e->seq = seq;
+	__asm__ volatile ("dsb" ::: "memory");
+	return (e);
+}
+
+static __inline void
+dwc_ring_end(struct dwc_ring_entry *e, int set_val, uint32_t val)
+{
+	if (e == NULL)
+		return;
+	if (set_val)
+		e->val = val;
+	e->tag |= DWC_RT_DONE;
+	__asm__ volatile ("dsb" ::: "memory");
+}
+
+/* Public: timeline markers from other code (heartbeat, IRQ wrappers). */
+void dwc_otg_ring_mark(uint32_t tag16, uint32_t val);
+void *dwc_otg_ring_mark_begin(uint32_t tag16, uint32_t val);
+void dwc_otg_ring_mark_end(void *handle);
+void dwc_otg_ring_mark_end_val(void *handle, uint32_t val);
+uint32_t dwc_otg_ring_boot_count(void);
+void
+dwc_otg_ring_mark(uint32_t tag16, uint32_t val)
+{
+	struct dwc_ring_entry *e = dwc_ring_begin(DWC_RT_MARK, tag16, val);
+
+	dwc_ring_end(e, 0, 0);
+}
+void *
+dwc_otg_ring_mark_begin(uint32_t tag16, uint32_t val)
+{
+	return (dwc_ring_begin(DWC_RT_MARK, tag16, val));
+}
+void
+dwc_otg_ring_mark_end(void *handle)
+{
+	dwc_ring_end((struct dwc_ring_entry *)handle, 0, 0);
+}
+void
+dwc_otg_ring_mark_end_val(void *handle, uint32_t val)
+{
+	dwc_ring_end((struct dwc_ring_entry *)handle, 1, val);
+}
+/* 0 until the ring is mapped; then 1 for the first boot after power-up. */
+uint32_t
+dwc_otg_ring_boot_count(void)
+{
+	return (dwc_ring != NULL ? dwc_ring->boot_count : 0);
+}
+
+static __inline void
+dwc_otg_wprobe(struct dwc_otg_softc *sc)
+{
+	struct dwc_ring_entry *e;
+	uint32_t v;
+
+	if (dwc_otg_wprobe_enable == 0)
+		return;
+	e = dwc_ring_begin(DWC_RT_READ, DOTG_GSNPSID_OFF, 0);
+	v = bus_space_read_4(sc->sc_io_tag, sc->sc_io_hdl, DOTG_GSNPSID_OFF);
+	dwc_ring_end(e, 1, v);
+}
+
+static void
+dwc_ring_init_and_dump(void)
+{
+	struct dwc_ring *r = (struct dwc_ring *)(uintptr_t)DWC_RING_PHYS;
+	uint32_t i, best, best_seq, start, n, boots, freq;
+
+	/* map 1 MB uncached (Device) section; RTEMS leaves it unmapped */
+	arm_cp15_set_translation_table_entries((const void *)r,
+	    (const void *)((uintptr_t)r + 0x100000u), ARMV7_MMU_DEVICE);
+
+	freq = arm_cp15_get_counter_frequency();
+	if (freq == 0)
+		freq = 19200000u;
+
+	if (r->magic0 == DWC_RING_MAGIC0 && r->magic1 == DWC_RING_MAGIC1 &&
+	    r->check == (r->magic0 ^ r->magic1 ^ r->boot_count)) {
+		boots = r->boot_count;
+		best = 0;
+		best_seq = 0;
+		for (i = 0; i < DWC_RING_ENTRIES; i++) {
+			if (r->e[i].seq > best_seq &&
+			    (r->e[i].seq & (DWC_RING_ENTRIES - 1)) == i) {
+				best_seq = r->e[i].seq;
+				best = i;
+			}
+		}
+		printk("\n===== DWC RING from previous boot #%u: last seq=%u, "
+		    "showing last %u accesses (oldest first) =====\n",
+		    (unsigned)boots, (unsigned)best_seq, DWC_RING_DUMP);
+		printk("legend: R=read W=write FW/FR=FIFO wr/rd (val=words) "
+		    "MK=marker (reg 0x4842=HB n, 0x4945/0x4944=IRQ-ctrl vector "
+		    "enable/disable write, 0x4946/0x4947=IRQ-ctrl PENDING1 "
+		    "read-back after enable/disable (val=pending), "
+		    "0x4943=core-mask mode GAHBCFG, 0x4958=IRQ_BASIC read, "
+		    "0x4950=IRQ_PENDING1/2 read, 0x4948=handler dispatch vector) "
+		    "; -N = timer ticks before last entry "
+		    "(~1 us) ; '*** PENDING' = access never completed\n");
+		n = (best_seq < DWC_RING_DUMP) ? best_seq : DWC_RING_DUMP;
+		start = best_seq - n + 1;
+		for (i = 0; i < n; i++) {
+			uint32_t sq = start + i;
+			struct dwc_ring_entry *e =
+			    &r->e[sq & (DWC_RING_ENTRIES - 1)];
+			uint32_t type = e->tag >> 28;
+			static const char *tn[] =
+			    { "??", "R ", "W ", "FW", "FR", "MK", "??", "??",
+			      "??", "??", "??", "??", "??", "??", "??", "??" };
+			uint32_t dt_us = (uint32_t)(r->e[best].tim - e->tim);
+
+			if (e->seq != sq) {
+				printk("RING %u: (overwritten/garbled)\n",
+				    (unsigned)sq);
+				continue;
+			}
+			printk("RING %u -%u %s reg=0x%03x val=0x%08x%s\n",
+			    (unsigned)sq, (unsigned)dt_us, tn[type & 15],
+			    (unsigned)(e->tag & 0xffff), (unsigned)e->val,
+			    (e->tag & DWC_RT_DONE) ? "" : "   *** PENDING");
+		}
+		printk("===== end of DWC RING dump =====\n\n");
+		boots++;
+	} else {
+		printk("DWC RING: no valid ring from a previous boot "
+		    "(cold power-up or first run)\n");
+		boots = 1;
+	}
+
+	/* reset for this boot */
+	for (i = 0; i < DWC_RING_ENTRIES; i++)
+		r->e[i].seq = 0;
+	r->cnt_freq = freq;
+	r->boot_count = boots;
+	r->magic0 = DWC_RING_MAGIC0;
+	r->magic1 = DWC_RING_MAGIC1;
+	r->check = DWC_RING_MAGIC0 ^ DWC_RING_MAGIC1 ^ boots;
+	__asm__ volatile ("dsb" ::: "memory");
+	dwc_ring_seq = 0;
+	dwc_ring = r;
+	printk("DWC RING: recording to 0x%08x (%u entries), boot #%u\n",
+	    (unsigned)DWC_RING_PHYS, DWC_RING_ENTRIES, (unsigned)boots);
+}
+
+static __inline void
+dwc_otg_trace_begin(char c, int chan)
+{
+	dwc_otg_trace_putc(c);
+	if (chan >= 0)
+		dwc_otg_trace_putc("0123456789abcdef"[chan & 15]);
+}
+
+static __inline uint32_t
+dwc_otg_traced_read_4(struct dwc_otg_softc *sc, uint32_t reg)
+{
+	uint32_t v;
+	int chan;
+	char c = dwc_otg_trace_class(reg, 0, 0, &chan);
+	struct dwc_ring_entry *e = dwc_ring_begin(DWC_RT_READ, reg, 0);
+
+	if (c == 0 || dwc_otg_trace_enable == 0) {
+		v = bus_space_read_4(sc->sc_io_tag, sc->sc_io_hdl, reg);
+		dwc_ring_end(e, 1, v);
+		return (v);
+	}
+	dwc_otg_trace_begin(c, chan);
+	v = bus_space_read_4(sc->sc_io_tag, sc->sc_io_hdl, reg);
+	dwc_ring_end(e, 1, v);
+	dwc_otg_trace_putc((char)(c - 'a' + 'A'));
+	return (v);
+}
+
+static __inline void
+dwc_otg_traced_write_4(struct dwc_otg_softc *sc, uint32_t reg, uint32_t data)
+{
+	int chan;
+	char c = dwc_otg_trace_class(reg, 1, data, &chan);
+	struct dwc_ring_entry *e = dwc_ring_begin(DWC_RT_WRITE, reg, data);
+
+	if (c == 0 || dwc_otg_trace_enable == 0) {
+		bus_space_write_4(sc->sc_io_tag, sc->sc_io_hdl, reg, data);
+		/* DSB so a stalled posted write is not marked DONE early */
+		__asm__ volatile ("dsb" ::: "memory");
+		dwc_ring_end(e, 0, 0);
+		dwc_otg_wprobe(sc);
+		return;
+	}
+	dwc_otg_trace_begin(c, chan);
+	bus_space_write_4(sc->sc_io_tag, sc->sc_io_hdl, reg, data);
+	__asm__ volatile ("dsb" ::: "memory");
+	dwc_ring_end(e, 0, 0);
+	dwc_otg_wprobe(sc);
+	dwc_otg_trace_putc((char)(c - 'a' + 'A'));
+}
+
+static __inline void
+dwc_otg_traced_write_region_4(bus_space_tag_t t, bus_space_handle_t h,
+    bus_size_t off, const uint32_t *buf, bus_size_t cnt)
+{
+	struct dwc_ring_entry *e = dwc_ring_begin(DWC_RT_FIFO_WR, off, cnt);
+
+	dwc_otg_trace_putc('w');
+	bus_space_write_region_4(t, h, off, buf, cnt);
+	__asm__ volatile ("dsb" ::: "memory");
+	dwc_ring_end(e, 0, 0);
+	if (dwc_otg_wprobe_enable != 0) {
+		struct dwc_ring_entry *e2 =
+		    dwc_ring_begin(DWC_RT_READ, DOTG_GSNPSID_OFF, 0);
+		uint32_t v = bus_space_read_4(t, h, DOTG_GSNPSID_OFF);
+		dwc_ring_end(e2, 1, v);
+	}
+	dwc_otg_trace_putc('W');
+}
+
+static __inline void
+dwc_otg_traced_read_region_4(bus_space_tag_t t, bus_space_handle_t h,
+    bus_size_t off, uint32_t *buf, bus_size_t cnt)
+{
+	struct dwc_ring_entry *e = dwc_ring_begin(DWC_RT_FIFO_RD, off, cnt);
+
+	dwc_otg_trace_putc('e');
+	bus_space_read_region_4(t, h, off, buf, cnt);
+	dwc_ring_end(e, 0, 0);
+	dwc_otg_trace_putc('E');
+}
+
+#undef DWC_OTG_READ_4
+#undef DWC_OTG_WRITE_4
+#define	DWC_OTG_READ_4(sc, reg)		dwc_otg_traced_read_4((sc), (reg))
+#define	DWC_OTG_WRITE_4(sc, reg, data)	dwc_otg_traced_write_4((sc), (reg), (data))
+
+/*
+ * 2026-10-13 (third capture): the access that stalls the SoC is the
+ * BCM2835 interrupt-controller ENABLE_IRQS_1 write issued by the RTEMS
+ * interrupt server right after the USB handler (marker 0x4945 PENDING;
+ * every DWC register access before it, including the GSNPSID read-back
+ * of the HCCHAR enable write, had completed).  Experiment: keep the
+ * interrupt-controller bit for the USB vector permanently enabled and
+ * mask/unmask the interrupt in the DWC core itself (GAHBCFG.GlblIntrMsk)
+ * instead.  Called from irqwrap.c (EPICS app) via the --wrap'ed
+ * bsp_interrupt_vector_enable/disable.  Both accesses are ring-logged.
+ * The read-back makes sure the mask took effect (level IRQ line) before
+ * the ISR returns.
+ */
+void dwc_otg_rtems_core_irq(int enable);
+void
+dwc_otg_rtems_core_irq(int enable)
+{
+	struct dwc_otg_softc *sc = dwc_ring_sc;
+
+	if (sc == NULL)
+		return;
+	DWC_OTG_WRITE_4(sc, DOTG_GAHBCFG,
+	    enable ? (GAHBCFG_GLBLINTRMSK | 0x10) : 0x10);
+	(void)DWC_OTG_READ_4(sc, DOTG_GAHBCFG);
+}
+#include <dev/usb/controller/dwc_otg_fiq_state.h>
+__attribute__((weak)) struct dwc_fiq_state *
+dwc_fiq_get_state(void) { return NULL; }
+__attribute__((weak)) uint32_t
+dwc_fiq_log_drain(char *out, uint32_t max_chars)
+{ (void)out; (void)max_chars; return 0; }
