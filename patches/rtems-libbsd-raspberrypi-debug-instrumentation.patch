+ * Diagnostic counters for RPi 3B+ hang debugging.
+ * Printed once per second from dwc_otg_timer().
+ * Safe to remove after the hang is resolved.
+ */
+static volatile uint32_t dwc_otg_diag_yield;       /* poll loop hit 16-iter cap */
