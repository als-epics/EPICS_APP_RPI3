diff -ruN a/freebsd/sys/dev/usb/controller/dwc_otg_fiq_state.h b/freebsd/sys/dev/usb/controller/dwc_otg_fiq_state.h
--- a/freebsd/sys/dev/usb/controller/dwc_otg_fiq_state.h	1969-12-31 16:00:00.000000000 -0800
+++ b/freebsd/sys/dev/usb/controller/dwc_otg_fiq_state.h	2026-10-14 10:13:16.412856258 -0700
@@ -0,0 +1,266 @@
+/*
+ * DWC OTG FIQ FSM — shared state between FIQ handler and main driver.
+ *
+ * This header is included by both the FIQ-side code (Layer A/B) and the
+ * FreeBSD driver modifications (Layer C).  Nothing here may pull in RTEMS
+ * or FreeBSD headers — keep it freestanding.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#ifndef DWC_OTG_FIQ_STATE_H
+#define DWC_OTG_FIQ_STATE_H
+
+#include <stdint.h>
+
+#define DWC_FIQ_MAX_CHANNELS 16
+#define DWC_FIQ_LOG_SIZE     4096  /* circular debug buffer bytes */
+
+/*
+ * BCM2835/2837 peripheral addresses (ARM physical).
+ * RPI_PERIPHERAL_BASE is 0x3F000000 on RPi 2/3.
+ */
+#define DWC_FIQ_RPI_PERIPH_BASE   0x3F000000u
+
+/* DWC OTG core registers */
+#define DWC_FIQ_USB_BASE          (DWC_FIQ_RPI_PERIPH_BASE + 0x980000u)
+
+/* MPHI (Multimedia Platform Host Interface) — software IRQ source.
+ * Used by Linux FIQ FSM for FIQ → IRQ signalling. */
+#define DWC_FIQ_MPHI_BASE         (DWC_FIQ_RPI_PERIPH_BASE + 0x6000u)
+#define DWC_FIQ_MPHI_OUTDDA       (DWC_FIQ_MPHI_BASE + 0x28u)
+#define DWC_FIQ_MPHI_OUTDDB       (DWC_FIQ_MPHI_BASE + 0x2Cu)
+#define DWC_FIQ_MPHI_CTRL         (DWC_FIQ_MPHI_BASE + 0x00u)
+#define DWC_FIQ_MPHI_INTSTAT      (DWC_FIQ_MPHI_BASE + 0x24u)
+#define DWC_FIQ_MPHI_SWIRQ_SET    (DWC_FIQ_MPHI_BASE + 0x1F0u)
+#define DWC_FIQ_MPHI_SWIRQ_CLR    (DWC_FIQ_MPHI_BASE + 0x1F4u)
+
+/* GPU system timer — SWIRQ source if MPHI is inaccessible.
+ * C3 is taken by the RTEMS clock driver; use C1 instead.
+ * (C0/C2 are reserved by the VideoCore GPU.) */
+#define DWC_FIQ_TIMER_BASE        (DWC_FIQ_RPI_PERIPH_BASE + 0x3000u)
+#define DWC_FIQ_TIMER_CS          (DWC_FIQ_TIMER_BASE + 0x00u)
+#define DWC_FIQ_TIMER_CLO         (DWC_FIQ_TIMER_BASE + 0x04u)
+#define DWC_FIQ_TIMER_C1          (DWC_FIQ_TIMER_BASE + 0x10u)
+#define DWC_FIQ_TIMER_CS_M1       0x00000002u
+
+/* BCM2835 interrupt controller */
+#define DWC_FIQ_INTC_BASE         (DWC_FIQ_RPI_PERIPH_BASE + 0xB200u)
+#define DWC_FIQ_INTC_FIQ_CTRL     (DWC_FIQ_INTC_BASE + 0x0Cu)
+
+/* BCM2835 IRQ numbers */
+#define DWC_FIQ_IRQ_USB           9u
+#define DWC_FIQ_IRQ_TIMER1        1u
+
+/* ------------------------------------------------------------------ */
+/* Direct MMIO — FIQ code cannot use bus_space_* or any RTEMS API.    */
+/* ------------------------------------------------------------------ */
+#define DWC_FIQ_REG(addr)  (*(volatile uint32_t *)(uintptr_t)(addr))
+
+/* DWC OTG register offsets from DWC_FIQ_USB_BASE */
+#define DWC_FIQ_GINTSTS    0x014u
+#define DWC_FIQ_GINTMSK    0x018u
+#define DWC_FIQ_HFNUM      0x408u
+#define DWC_FIQ_HAINT      0x414u
+#define DWC_FIQ_HAINTMSK   0x418u
+#define DWC_FIQ_HCCHAR(n)  (0x500u + 0x20u * (n))
+#define DWC_FIQ_HCSPLT(n)  (0x504u + 0x20u * (n))
+#define DWC_FIQ_HCINT(n)   (0x508u + 0x20u * (n))
+#define DWC_FIQ_HCINTMSK(n)(0x50Cu + 0x20u * (n))
+#define DWC_FIQ_HCTSIZ(n)  (0x510u + 0x20u * (n))
+#define DWC_FIQ_HCDMA(n)   (0x514u + 0x20u * (n))
+
+/* ------------------------------------------------------------------ */
+/* GINTSTS / GINTMSK bits used by FIQ dispatch.                        */
+/* ------------------------------------------------------------------ */
+#define DWC_FIQ_GINTSTS_SOF       (1u << 3)
+#define DWC_FIQ_GINTSTS_HCHINT    (1u << 25)
+
+/* ------------------------------------------------------------------ */
+/* HCINT bits — channel interrupt status.                              */
+/* ------------------------------------------------------------------ */
+#define DWC_FIQ_HCINT_XFERCOMPL   (1u << 0)
+#define DWC_FIQ_HCINT_CHHLTD      (1u << 1)
+#define DWC_FIQ_HCINT_AHBERR      (1u << 2)
+#define DWC_FIQ_HCINT_STALL       (1u << 3)
+#define DWC_FIQ_HCINT_NAK         (1u << 4)
+#define DWC_FIQ_HCINT_ACK         (1u << 5)
+#define DWC_FIQ_HCINT_NYET        (1u << 6)
+#define DWC_FIQ_HCINT_XACTERR     (1u << 7)
+#define DWC_FIQ_HCINT_BBLERR      (1u << 8)
+#define DWC_FIQ_HCINT_FRMOVRUN    (1u << 9)
+#define DWC_FIQ_HCINT_DATATGLERR  (1u << 10)
+
+/* ------------------------------------------------------------------ */
+/* HCCHAR bits.                                                        */
+/* ------------------------------------------------------------------ */
+#define DWC_FIQ_HCCHAR_CHENA      (1u << 31)
+#define DWC_FIQ_HCCHAR_CHDIS      (1u << 30)
+#define DWC_FIQ_HCCHAR_ODDFRM     (1u << 29)
+#define DWC_FIQ_HCCHAR_EPDIR_IN   (1u << 15)
+
+/* ------------------------------------------------------------------ */
+/* HCSPLT bits.                                                        */
+/* ------------------------------------------------------------------ */
+#define DWC_FIQ_HCSPLT_SPLTENA    (1u << 31)
+#define DWC_FIQ_HCSPLT_COMPSPLT   (1u << 16)
+
+/* ------------------------------------------------------------------ */
+/* HFNUM — frame number register.                                      */
+/* ------------------------------------------------------------------ */
+#define DWC_FIQ_HFNUM_FRNUM_MASK  0x0000FFFFu
+
+/* Max CSPLIT retries before aborting (Linux uses 3). */
+#define DWC_FIQ_CSPLIT_RETRIES    3
+/* Max transaction errors before aborting. */
+#define DWC_FIQ_MAX_ERRORS        3
+
+/* ------------------------------------------------------------------ */
+/* Per-channel FSM states.                                             */
+/* Modelled on Linux dwc_otg_fiq_fsm.h — states added incrementally.  */
+/* Phase 1: only PASSTHROUGH and PASSTHROUGH_ERRORSTATE.               */
+/* ------------------------------------------------------------------ */
+enum dwc_fiq_fsm_state {
+    /* Channel not managed by FIQ — all events forwarded to IRQ. */
+    FIQ_PASSTHROUGH             = 0,
+    FIQ_PASSTHROUGH_ERRORSTATE  = 1,
+
+    /* --- Phase 3: periodic split states (to be added) --- */
+    FIQ_PER_SSPLIT_QUEUED       = 10,
+    FIQ_PER_SSPLIT_STARTED      = 11,
+    FIQ_PER_SSPLIT_LAST         = 12,
+    FIQ_PER_CSPLIT_WAIT         = 13,
+    FIQ_PER_CSPLIT_NYET1        = 14,
+    FIQ_PER_CSPLIT_BROKEN_NYET1 = 15,
+    FIQ_PER_CSPLIT_NYET_FAFF    = 16,
+    FIQ_PER_CSPLIT_POLL         = 17,
+    FIQ_PER_CSPLIT_LAST         = 18,
+    FIQ_PER_SPLIT_DONE          = 19,
+    FIQ_PER_SPLIT_LS_ABORTED    = 20,
+    FIQ_PER_SPLIT_HS_ABORTED    = 21,
+    FIQ_PER_SPLIT_NYET_ABORTED  = 22,
+    FIQ_PER_SPLIT_TIMEOUT       = 23,
+
+    /* --- Phase 4: non-periodic split states (to be added) --- */
+    FIQ_NP_SSPLIT_STARTED       = 30,
+    FIQ_NP_SSPLIT_RETRY         = 31,
+    FIQ_NP_SSPLIT_PENDING       = 32,
+    FIQ_NP_OUT_CSPLIT_RETRY     = 33,
+    FIQ_NP_IN_CSPLIT_RETRY      = 34,
+    FIQ_NP_SPLIT_DONE           = 35,
+    FIQ_NP_SPLIT_LS_ABORTED     = 36,
+    FIQ_NP_SPLIT_HS_ABORTED     = 37,
+
+    /* --- Phase 4: isochronous (optional) --- */
+    FIQ_PER_ISO_OUT_PENDING     = 50,
+    FIQ_PER_ISO_OUT_ACTIVE      = 51,
+    FIQ_PER_ISO_OUT_LAST        = 52,
+    FIQ_PER_ISO_OUT_DONE        = 53,
+    FIQ_HS_ISOC_TURBO           = 60,
+    FIQ_HS_ISOC_SLEEPING        = 61,
+    FIQ_HS_ISOC_DONE            = 62,
+    FIQ_HS_ISOC_ABORTED         = 63,
+
+    /* Admin */
+    FIQ_DEQUEUE_ISSUED          = 70,
+};
+
+/* ------------------------------------------------------------------ */
+/* Per-channel shadow state.                                           */
+/*                                                                     */
+/* HANDOFF PROTOCOL (review finding #6):                               */
+/*   Task context (Layer C) writes all shadow fields, then does a DMB, */
+/*   then sets .fsm to non-PASSTHROUGH.  FIQ checks .fsm first; if    */
+/*   PASSTHROUGH, it ignores shadow fields entirely.  FIQ never writes */
+/*   .fsm back to PASSTHROUGH — that's Layer C's job after SWIRQ.     */
+/* ------------------------------------------------------------------ */
+struct dwc_fiq_channel_state {
+    enum dwc_fiq_fsm_state fsm;
+
+    /* Shadow copies of host-channel registers (written by Layer C). */
+    uint32_t hcchar_copy;
+    uint32_t hcsplt_copy;
+    uint32_t hcint_copy;
+    uint32_t hcintmsk_copy;
+    uint32_t hctsiz_copy;
+    uint32_t hcdma_copy;
+
+    /* Per-channel bookkeeping */
+    uint32_t nr_errors;
+    uint32_t hub_addr;
+    uint32_t port_addr;
+    uint32_t expected_uframe;
+    uint32_t nrpackets;
+    uint32_t nyet_count;
+    uint32_t csplit_count;
+};
+
+/* ------------------------------------------------------------------ */
+/* Global FIQ state — one instance, allocated by Layer A init.         */
+/* ------------------------------------------------------------------ */
+struct dwc_fiq_state {
+    /* DWC OTG core base (ARM physical, for direct MMIO from FIQ). */
+    uint32_t usb_base;
+
+    /* Number of host channels present in hardware. */
+    uint32_t num_channels;
+
+    /* Shadow interrupt masks (Layer C writes, FIQ reads). */
+    uint32_t gintmsk_saved;
+    uint32_t haintmsk_saved;
+
+    /* FIQ → IRQ signalling: nonzero = use MPHI, zero = use timer C3. */
+    uint32_t use_mphi;
+
+    /* Set by FIQ when SWIRQ is pending; cleared by IRQ handler. */
+    volatile uint32_t irq_pending;
+
+    /* Bitmask of channels in a terminal FSM state needing SWIRQ pickup. */
+    volatile uint32_t channel_done_mask;
+
+    /* Bitmask of channels with active (non-PASSTHROUGH) FSM states.
+     * Set by Layer C on handoff, cleared by FIQ on terminal state.
+     * FIQ only handles SOF when this is nonzero. */
+    volatile uint32_t fsm_active_mask;
+
+    /* FIQ-side counters. */
+    volatile uint32_t fiq_count;
+    volatile uint32_t swirq_count;
+    volatile uint32_t sof_count;
+
+    /* Circular debug log (review finding: must be in Phase 1). */
+    volatile uint32_t log_head;
+    char log_buf[DWC_FIQ_LOG_SIZE];
+
+    /* Per-channel state. */
+    struct dwc_fiq_channel_state channel[DWC_FIQ_MAX_CHANNELS];
+};
+
+/* ------------------------------------------------------------------ */
+/* FIQ debug log — writes to circular buffer, safe from FIQ context.   */
+/* ------------------------------------------------------------------ */
+static inline void dwc_fiq_log_char(struct dwc_fiq_state *st, char c)
+{
+    uint32_t h = st->log_head;
+    st->log_buf[h] = c;
+    st->log_head = (h + 1) & (DWC_FIQ_LOG_SIZE - 1);
+}
+
+static inline void dwc_fiq_log_hex32(struct dwc_fiq_state *st, uint32_t v)
+{
+    static const char hex[] = "0123456789abcdef";
+    int i;
+    for (i = 28; i >= 0; i -= 4)
+        dwc_fiq_log_char(st, hex[(v >> i) & 0xF]);
+    dwc_fiq_log_char(st, ' ');
+}
+
+/* ------------------------------------------------------------------ */
+/* ARM memory barrier — used in handoff protocol.                      */
+/* ------------------------------------------------------------------ */
+static inline void dwc_fiq_dmb(void)
+{
+    __asm__ volatile ("dmb" ::: "memory");
+}
+
+#endif /* DWC_OTG_FIQ_STATE_H */
